{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kordra",
  "version": "0.1.0",
  "identifier": "com.kordraproject.kordra",
  "build": {
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kordra",
        "width": 1250,
        "height": 810,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8079 ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/kordra-daemon"],
    "shortDescription": "Universal download manager"
  }
}
