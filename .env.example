KORDRA_LISTEN=127.0.0.1:8079
KORDRA_DATA_DIR=./data
KORDRA_DOWNLOAD_DIR=./downloads
# Do not publish unauthenticated endpoints.
# KORDRA_API_TOKEN=
# KORDRA_METRICS_TOKEN=

# Maximum simultaneous active download/recheck workers (1..32, default 2).
KORDRA_CONCURRENCY=2

# Optional initial concurrency before an API/UI override is persisted.
# Runtime limits and future startups thereafter use config/transfer-settings.json.
